<section class="page-heading">
  <div>
    <h1>Entregas</h1>
    <p class="page-intro">Lista de entregas cadastradas.</p>
  </div>
  <a class="button button-primary" href="/entregas/nova">Nova entrega</a>
</section>

<section class="panel">
  <div class="panel-heading">
    <div>
      <p class="muted"><%= entregas.length %> <%= entregas.length === 1 ? 'registro' : 'registros' %></p>
    </div>
    <form class="filter-form" action="/entregas" method="GET">
      <label class="sr-only" for="filtro-status">Filtrar por status</label>
      <select id="filtro-status" name="status">
        <option value="">Todos os status</option>
        <% for (const status of ['CRIADA', 'EM_TRANSITO', 'ENTREGUE', 'CANCELADA']) { %>
          <option value="<%= status %>" <%= statusFiltro === status ? 'selected' : '' %>><%= status.replace('_', ' ') %></option>
        <% } %>
      </select>
      <button class="button button-secondary" type="submit">Filtrar</button>
      <% if (statusFiltro) { %><a class="text-link" href="/entregas">Limpar</a><% } %>
    </form>
  </div>

  <% if (entregas.length) { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Entrega</th><th>Origem</th><th>Destino</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% for (const entrega of entregas) { %>
            <tr>
              <td><a class="table-link" href="/entregas/<%= entrega.id %>"><%= entrega.descricao %></a><span class="cell-subtitle">#<%= entrega.id %></span></td>
              <td><%= entrega.origem %></td>
              <td><%= entrega.destino %></td>
              <td><span class="status-badge status-<%= entrega.status.toLowerCase() %>"><%= entrega.status.replace('_', ' ') %></span></td>
              <td class="text-right"><a class="text-link" href="/entregas/<%= entrega.id %>">Ver detalhes →</a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <h3>Nenhuma entrega cadastrada</h3>
      <% if (statusFiltro) { %><p>Limpe o filtro para ver todas as entregas.</p><% } %>
    </div>
  <% } %>
</section>
